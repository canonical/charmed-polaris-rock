apiVersion: v1
kind: ConfigMap
metadata:
  name: polaris-config
  namespace: ${NAMESPACE}
data:
  application.properties: |
    polaris.bootstrap.credentials=POLARIS,root,s3cr3t
    polaris.realm-context.realms=POLARIS
    polaris.readiness.ignore-severe-issues=true
    polaris.persistence.type=relational-jdbc
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: polaris
  namespace: ${NAMESPACE}
  labels:
    app: polaris
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: polaris
  template:
    metadata:
      labels:
        app: polaris
    spec:
      containers:
        - name: polaris
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8181
            - name: management
              containerPort: 8182
          env:
            - name: QUARKUS_CONFIG_LOCATIONS
              value: "file:///etc/polaris/application.properties"
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: polaris-s3-credentials
                  key: aws-access-key-id
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: polaris-s3-credentials
                  key: aws-secret-access-key
            - name: AWS_REGION
              valueFrom:
                secretKeyRef:
                  name: polaris-s3-credentials
                  key: aws-region
            - name: QUARKUS_DATASOURCE_JDBC_URL
              valueFrom:
                secretKeyRef:
                  name: polaris-db-credentials
                  key: jdbc-url
            - name: QUARKUS_DATASOURCE_USERNAME
              valueFrom:
                secretKeyRef:
                  name: polaris-db-credentials
                  key: db-user
            - name: QUARKUS_DATASOURCE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: polaris-db-credentials
                  key: db-password
          volumeMounts:
            - name: polaris-shared-config
              mountPath: /etc/polaris
              readOnly: true
          readinessProbe:
            httpGet:
              path: /q/health/ready
              port: 8182
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /q/health/live
              port: 8182
            initialDelaySeconds: 15
            periodSeconds: 10
      volumes:
        - name: polaris-shared-config
          configMap:
            name: polaris-config
---
apiVersion: v1
kind: Service
metadata:
  name: polaris
  namespace: ${NAMESPACE}
  labels:
    app: polaris
spec:
  type: LoadBalancer
  selector:
    app: polaris
  ports:
    - name: http
      port: 8181
      targetPort: 8181
      protocol: TCP
    - name: management
      port: 8182
      targetPort: 8182
      protocol: TCP
